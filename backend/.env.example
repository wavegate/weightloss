HOST=your-rds-host.amazonaws.com
PORT=5432
USER=postgres
PASSWORD=your-password
DATABASE=weightloss

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4

CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Vercel frontend URL — required in production for CORS (scheme + host only).
FRONTEND_URL=https://weightloss-inky.vercel.app

# Optional extra browser origins (comma-separated), e.g. preview deploys:
# CORS_ORIGINS=https://your-app-git-branch.vercel.app

# Local Vite dev (when FRONTEND_URL points at production, keep these for local UI):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
